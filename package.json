{
  "name": "clubflow",
  "version": "1.0.0",
  "private": true,
  "description": "ClubFlow — one university-club event brief in, ready-to-copy channel previews out. Generate only. Nothing is published.",
  "type": "module",
  "scripts": {
    "start": "vite --host 0.0.0.0 --port 43123",
    "dev": "vite --host 0.0.0.0 --port 43123",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 43123",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@fontsource/noto-sans-tc": "^5.2.8",
    "@fontsource/outfit": "^5.2.8"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vite": "^6.0.11"
  }
}
