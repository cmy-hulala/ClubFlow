# Copy to .env. Never commit .env.

# PayPal REST app (sandbox). https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Business account email that owns the sandbox REST app. Required before Invoicing.
# Dashboard → Sandbox → Accounts → business account. Any other address is rejected.
PAYPAL_MERCHANT_EMAIL=
# Sandbox personal-account email that receives the speaker payout.
PAYPAL_SPEAKER_EMAIL=speaker-ken-lin@personal.example.com
# From the webhook you create for this app. Optional; without it events are accepted and marked unverified.
PAYPAL_WEBHOOK_ID=
# sandbox is the only supported environment. Do not point this demo at live.
PAYPAL_ENV=sandbox

# Set to 1 to force simulated PayPal calls even if credentials exist.
# Leave unset with empty credentials and the server still runs in mock mode (banner explains how to switch).
# Set to 0 to refuse money calls until credentials exist.
MOCK_PAYPAL=

# Optional. Without a key the officer chat uses a deterministic intent parser.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional email. If neither is set, messages land in the in-app outbox.
RESEND_API_KEY=
RESEND_FROM=ClubFlow <onboarding@resend.dev>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=ClubFlow <eic.nycu@example.com>

# API port. The Vite dev server stays on 43123 and proxies /api here.
PORT=8787
# Browser origin, used in receipt links and subscription return URLs.
PUBLIC_BASE_URL=http://127.0.0.1:43123
# Set only if the static UI is hosted on another origin (Vercel) and calls this API.
CORS_ORIGIN=
# Override the JSON ledger path. On Vercel the default is the temp directory.
CLUBFLOW_STORE=
